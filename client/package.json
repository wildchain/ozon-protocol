{
  "name": "gill-react-vite-tailwind",
  "description": "React+Vite, Tailwind, gill (based on @solana/kit), Wallet UI",
  "keywords": [
    "gill",
    "react",
    "solana-kit",
    "tailwind",
    "typescript",
    "vite",
    "wallet-ui"
  ],
  "create-solana-dapp": {
    "rename": {
      "scaffold": {
        "to": "{{name}}",
        "paths": [
          "src"
        ]
      }
    }
  },
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@gillsdk/react": "^0.6.0",
    "@linaria/core": "^6.3.0",
    "@linaria/react": "^6.3.0",
    "@mantine/core": "^8.3.2",
    "@mantine/dates": "^8.3.2",
    "@mantine/hooks": "^8.3.2",
    "@mantine/notifications": "^8.3.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.90.2",
    "@vanilla-extract/css": "^1.17.4",
    "@wallet-ui/react": "2.0.0",
    "@wallet-ui/react-gill": "2.0.0",
    "@wallet-ui/tailwind": "2.0.0",
    "axios": "^1.12.2",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "gill": "0.11.0",
    "input-otp": "^1.4.2",
    "jotai": "^2.14.0",
    "lucide-react": "^0.544.0",
    "luxon": "^3.7.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-day-picker": "^9.11.0",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-resizable-panels": "^3.0.6",
    "react-router": "^7.9.1",
    "recharts": "^3.2.1",
